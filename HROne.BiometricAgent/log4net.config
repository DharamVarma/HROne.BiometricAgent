<?xml version="1.0" encoding="utf-8" ?>

<log4net>
  
  <!-- Rolling File Appender -->
  <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
    <file value="Logs\HROneBiometricAgentLogs.txt" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maximumFileSize value="10MB" />
    <maxSizeRollBackups value="-1" />
    <staticLogFileName value="true" />
    <preserveLogFileNameExtension value="true" />

    <layout type="log4net.Layout.PatternLayout">
    <conversionPattern value="
    Timestamp   : %date{yyyy-MM-dd HH:mm:ss zzz} %newline
    AppVersion  : %property{AppVersion} %newline
    Level       : %-5level %newline
    Thread      : [%thread] %newline
    Logger      : %logger %newline
    Message     : %message %newline
    Exception   : %exception %newline%newline
    ======================================================================%newline%newline" />
    </layout>
  </appender>

  <!-- Root Logger -->
  <root>
    <level value="INFO" />
    <appender-ref ref="RollingFileAppender" />
  </root>

</log4net>
